# Mishran environment variables
# Copy this file to .env.local and fill in real values.

# Database (MongoDB). Use mongodb+srv:// for Atlas.
MONGODB_URI=mongodb://mishran:mishrandev@localhost:27017/mishran?replicaSet=rs0&authSource=admin

# Payload session/JWT secret. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=replace-with-32+-char-random-string

# Transactional email (Resend)
RESEND_API_KEY=

# Lead notifications — recipient address for new-lead emails (Resend).
# Consumed by lib/leads-api.ts. Falls back to ops@mishran.shop if unset;
# set explicitly in prod so the fallback is never relied on.
LEADS_INBOX=ops@mishran.shop

# Analytics
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Contact / WhatsApp
NEXT_PUBLIC_WHATSAPP_NUMBER=+91XXXXXXXXXX

# Canonical site URL (no trailing slash). Used by sitemap.xml, robots.txt,
# and JSON-LD structured data. Defaults to http://localhost:3000 in dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# On-demand ISR revalidation webhook secret. Required in production.
# Payload afterChange hooks send this as x-revalidate-secret; the
# /api/revalidate route rejects requests with a missing/wrong header.
# When unset, the route is open (dev convenience only).
# Generate with: openssl rand -hex 32
REVALIDATE_SECRET=

# ---------------------------------------------------------------------------
# Mobile API + native apps (Task 0.1 stubs — wired in later tasks)
# These vars are NOT yet consumed by the codebase. They are listed here as
# placeholders so future tasks (auth, payments, push, analytics) have a
# documented home. Leave commented/blank until the consuming task lands.
# ---------------------------------------------------------------------------

# JWT (RS256) — generate with:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Commerce delivery fees (paise). Flat fee by pincode serviceability tier:
# fresh = same-city made-daily tier, shelf = couriered shelf-stable tier.
# Defaults ₹49 / ₹99; override only with a deliberate pricing decision.
# DELIVERY_FEE_FRESH_PAISE=4900
# DELIVERY_FEE_SHELF_STABLE_PAISE=9900

# Free-delivery thresholds (paise). At/above the tier's threshold the
# delivery fee drops to 0. 0 disables the threshold for that tier.
# Defaults ₹999 / ₹1,999.
# FREE_DELIVERY_THRESHOLD_FRESH_PAISE=99900
# FREE_DELIVERY_THRESHOLD_SHELF_STABLE_PAISE=199900

# Razorpay
# RAZORPAY_KEY_ID=rzp_test_xxx
# RAZORPAY_KEY_SECRET=xxx
# RAZORPAY_WEBHOOK_SECRET=xxx
# Public key id handed to the checkout widget by /payments/razorpay/
# create-order. Inlined at BUILD time by Next.js — must be set before the
# production build. Falls back to RAZORPAY_KEY_ID when unset (same value
# in test mode).
# NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxx

# MSG91
# MSG91_AUTH_KEY=xxx
# MSG91_SENDER_ID=MISHRN
# MSG91_TEMPLATE_OTP=xxx
# MSG91_TEMPLATE_ORDER_STATUS=xxx

# Test login seam (temporary) — phone OTP bypass for testers/family.
# OTP_BYPASS_PHONE is a COMMA-SEPARATED list (whitespace tolerated):
#   OTP_BYPASS_PHONE="+918088983014,+919812345678"
# Listed phones skip the SMS provider at /auth/otp/send and verify with the
# fixed OTP_BYPASS_CODE at /auth/otp/verify (all other rules still apply:
# rate limits, expiry, attempt throttle, consume-on-success). Needed while
# MSG91 keys are placeholders. Leave unset/empty to disable the seam.
# OTP_BYPASS_PHONE=+918088983014
# OTP_BYPASS_CODE=424242

# FCM (Android push)
# FCM_PROJECT_ID=mishran-prod
# FCM_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'

# APNs (iOS push + Live Activity — Task 18.4). Token-based .p8 auth.
# APNS_PROVIDER=fake (default in NODE_ENV=test) selects FakePushService;
# 'apns' selects ApnsPushService (falls back to fake when key/team/private
# unset, so a box without APNs creds never attempts an unreachable call).
# Requires Apple Developer Program enrollment (plan Open Question #8).
# APNS_PROVIDER=apns
# APNS_TEAM_ID=
# APNS_KEY_ID=
# APNS_PRIVATE_KEY=
# APNS_BUNDLE_ID=com.mishran.app

# Sentry (self-hosted)
# SENTRY_DSN=http://xxx@localhost:9000/1

# Storage (local disk in v1)
# STORAGE_PROVIDER=local
# STORAGE_LOCAL_PATH=./uploads

# Feature flags
# FLAG_PROVIDER=env

# App
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/mobile/v1
NEXT_PUBLIC_APP_NAME=Mishran
NODE_ENV=development

# Sign in with Apple (Task 15.3) — Services ID / Client ID used as the JWT
# audience. APPLE_AUTH_PROVIDER=fake (default in NODE_ENV=test) selects the
# test fake; 'apple' selects the real JWKS verifier.
# APPLE_CLIENT_ID=com.mishran.web
# APPLE_AUTH_PROVIDER=apple

# Apple Wallet loyalty passes (Task 18.5) — requires Apple Developer Program
# enrollment (plan Open Question #8). Until the P12 + WWDR certs land, the
# container resolves to FakeWalletService so no unsigned .pkpass is served.
# WALLET_PROVIDER=node-passbook
# PASSBOOK_CERT_PATH=certs/passbook.p12
# PASSBOOK_CERT_PASSWORD=
# PASSBOOK_WWDR_PATH=certs/wwdr.pem
# APPLE_TEAM_ID=
# APPLE_PASS_TYPE_ID=pass.com.mishran.wallet
# WALLET_PASSES_BUCKET=mithran-wallet-passes
# Object storage for signed passes — self-hosted MinIO by default; S3 swap is
# config-only (infra-first ADR). STORAGE_PROVIDER drives the media adapter.
# STORAGE_ENDPOINT=http://localhost:9000
# STORAGE_REGION=us-east-1
# STORAGE_ACCESS_KEY=minioadmin
# STORAGE_SECRET_KEY=minioadmin
