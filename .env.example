# Mishran environment variables
# Copy this file to .env.local and fill in real values.

# Database (MongoDB). Use mongodb+srv:// for Atlas.
MONGODB_URI=mongodb://mishran:mishrandev@localhost:27017/mishran?replicaSet=rs0&authSource=admin

# Payload session/JWT secret. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=replace-with-32+-char-random-string

# Transactional email (Resend)
RESEND_API_KEY=

# Lead notifications — recipient address for new-lead emails (Resend).
# Consumed by lib/leads-api.ts. Falls back to ops@mishran.shop if unset;
# set explicitly in prod so the fallback is never relied on.
LEADS_INBOX=ops@mishran.shop

# Analytics
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Contact / WhatsApp
NEXT_PUBLIC_WHATSAPP_NUMBER=+91XXXXXXXXXX

# Canonical site URL (no trailing slash). Used by sitemap.xml, robots.txt,
# and JSON-LD structured data. Defaults to http://localhost:3000 in dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# On-demand ISR revalidation webhook secret. Required in production.
# Payload afterChange hooks send this as x-revalidate-secret; the
# /api/revalidate route rejects requests with a missing/wrong header.
# When unset, the route is open (dev convenience only).
# Generate with: openssl rand -hex 32
REVALIDATE_SECRET=

# ---------------------------------------------------------------------------
# Mobile API + native apps (Task 0.1 stubs — wired in later tasks)
# These vars are NOT yet consumed by the codebase. They are listed here as
# placeholders so future tasks (auth, payments, push, analytics) have a
# documented home. Leave commented/blank until the consuming task lands.
# ---------------------------------------------------------------------------

# JWT (RS256) — generate with:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Razorpay
# RAZORPAY_KEY_ID=rzp_test_xxx
# RAZORPAY_KEY_SECRET=xxx
# RAZORPAY_WEBHOOK_SECRET=xxx

# MSG91
# MSG91_AUTH_KEY=xxx
# MSG91_SENDER_ID=MISHRN
# MSG91_TEMPLATE_OTP=xxx
# MSG91_TEMPLATE_ORDER_STATUS=xxx

# FCM (Android push)
# FCM_PROJECT_ID=mishran-prod
# FCM_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'

# APNs (iOS v2 — leave blank for v1)
# APNS_TEAM_ID=
# APNS_KEY_ID=
# APNS_PRIVATE_KEY=

# Sentry (self-hosted)
# SENTRY_DSN=http://xxx@localhost:9000/1

# Storage (local disk in v1)
# STORAGE_PROVIDER=local
# STORAGE_LOCAL_PATH=./uploads

# Feature flags
# FLAG_PROVIDER=env

# App
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/mobile/v1
NEXT_PUBLIC_APP_NAME=Mishran
NODE_ENV=development

# Sign in with Apple (Task 15.3) — Services ID / Client ID used as the JWT
# audience. APPLE_AUTH_PROVIDER=fake (default in NODE_ENV=test) selects the
# test fake; 'apple' selects the real JWKS verifier.
# APPLE_CLIENT_ID=com.mishran.web
# APPLE_AUTH_PROVIDER=apple
