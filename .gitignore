# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Apple passbook credentials (Task 18.5). Never commit secrets.
certs/*.p12
certs/*.key
certs/*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright-mcp session artifacts
.playwright-mcp/

# superpowers scratch
.superpowers/

# payload uploads (dev)
/media/
.payload/

# testing artifacts
.lhci/
playwright-report/
test-results/

.env

apps/ios/build/
