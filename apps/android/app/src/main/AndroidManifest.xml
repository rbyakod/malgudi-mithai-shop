<?xml version="1.0" encoding="utf-8"?>
<!--
  apps/android/app/src/main/AndroidManifest.xml — Task 7.1 / 7.4 / 13.1.
  Application class (Hilt), launcher MainActivity, and the mishran:// deep-link
  intent filter. Cleartext is gated to the emulator loopback only via
  network_security_config (production uses https).

  PERMISSIONS (Task 13.1 — minimal set, each earns its place):
    INTERNET               — all API traffic (catalog, orders, payments).
    ACCESS_NETWORK_STATE   — offline-first cache decides refresh vs stale
                             serve by observing connectivity.
    USE_BIOMETRIC          — BiometricPrompt gate over the encrypted
                             refresh token (opt-in "quick access").
    POST_NOTIFICATIONS     — order-update pushes (FCM). Runtime-requested
                             on Android 13+; never required to order.

  Deliberately NOT declared (Play policy + least privilege):
    RECEIVE_SMS / READ_SMS — OTP autofill uses the SMS Retriever API, which
                             matches the app-signature hash with NO SMS
                             permission (Task 8.3). Declaring SMS read would
                             trigger Play's sensitive-permission review for
                             zero benefit.
    CAMERA                 — the gift-builder feature is deferred out of v1;
                             add it with that feature, not before.
    WAKE_LOCK / FOREGROUND_SERVICE — WorkManager and FirebaseMessagingService
                             merge what they need from their own library
                             manifests; nothing in v1 runs a user-visible
                             foreground service.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".MishranApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mishran">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Mishran">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link: mishran://order/{id} → order detail (Task 7.4). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mishran" android:host="order" />
            </intent-filter>
        </activity>

        <!-- Task 9.2: on-demand WorkManager init via MishranApp's
             HiltWorkerFactory (the default initializer can't inject workers). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="remove" />

        <!-- Task 11.2: home-screen order-status widget (Glance). -->
        <receiver
            android:name=".widget.OrderStatusWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/order_status_widget_info" />
        </receiver>

        <!-- Task 11.3: FCM order-update pushes. The google-services plugin is
             deliberately not applied until google-services.json is provisioned
             (release-build flavor, Task 13.3) — see app/build.gradle.kts. -->
        <service
            android:name=".push.MishranFcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
