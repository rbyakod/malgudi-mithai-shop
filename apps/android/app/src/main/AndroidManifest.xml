<?xml version="1.0" encoding="utf-8"?>
<!--
  apps/android/app/src/main/AndroidManifest.xml — Task 7.1 / 7.4.
  Application class (Hilt), launcher MainActivity, and the mishran:// deep-link
  intent filter. Cleartext is gated to the emulator loopback only via
  network_security_config (production uses https). Firebase messaging service +
  additional intent filters land in their own tasks (11.3, 13.1).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".MishranApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mishran">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Mishran">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link: mishran://order/{id} → order detail (Task 7.4). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mishran" android:host="order" />
            </intent-filter>
        </activity>

        <!-- Task 9.2: on-demand WorkManager init via MishranApp's
             HiltWorkerFactory (the default initializer can't inject workers). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="remove" />

        <!-- Task 11.2: home-screen order-status widget (Glance). -->
        <receiver
            android:name=".widget.OrderStatusWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/order_status_widget_info" />
        </receiver>
    </application>
</manifest>
