{
  "name": "mithai-shop",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "predev": "node --import tsx scripts/regen-importmap.mjs",
    "prebuild": "node --import tsx scripts/regen-importmap.mjs && pnpm codegen:ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lhci": "lhci autorun",
    "codegen": "pnpm -r --filter './packages/*' run codegen",
    "codegen:ts": "pnpm -r --filter '@mishran/api-contract' run codegen:ts",
    "build:packages": "pnpm -r --filter './packages/*' run build",
    "seed": "tsx scripts/seed.ts",
    "seed:staging": "tsx scripts/seed-staging.ts",
    "regen:importmap": "node --import tsx scripts/regen-importmap.mjs",
    "ios:xcodegen": "xcodegen --spec apps/ios/project.yml",
    "ios:build": "xcodebuild -project apps/ios/Mishran.xcodeproj -scheme Mishran -destination 'platform=iOS Simulator,name=iPhone SE (3rd generation),OS=17.2' build",
    "ios:test": "xcodebuild test -project apps/ios/Mishran.xcodeproj -scheme Mishran -destination 'platform=iOS Simulator,name=iPhone SE (3rd generation),OS=17.2'",
    "ios:e2e": "bash apps/ios/maestro/run-flows.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1107.0",
    "@aws-sdk/s3-request-presigner": "^3.1107.0",
    "@payloadcms/db-mongodb": "^3.87.1",
    "@payloadcms/next": "^3.87.1",
    "@payloadcms/richtext-lexical": "^3.87.1",
    "@payloadcms/ui": "^3.87.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@swc/helpers": "^0.5.23",
    "@tanstack/react-query": "^5.101.4",
    "argon2": "^0.45.1",
    "firebase-admin": "^14.2.0",
    "jose": "^6.2.8",
    "mongodb": "^7.5.0",
    "next": "^16.2.12",
    "next-intl": "^4.9.1",
    "payload": "^3.87.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "razorpay": "^2.9.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.19.0",
    "sharp": "^0.35.3",
    "sonner": "^2.0.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supertest": "^7.2.1",
    "@vercel/config": "^0.5.6",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "axe-core": "^4.13.0",
    "eslint": "^9",
    "eslint-config-next": "^16.2.12",
    "jsdom": "^29.1.1",
    "lighthouse": "^12.8.2",
    "mongodb-memory-server": "^11.2.0",
    "nock": "^14.0.17",
    "supertest": "^7.2.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
